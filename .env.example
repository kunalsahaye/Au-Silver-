# Copy to .env.local for local development. On Vercel, set these in Project > Settings > Environment Variables.
# Connecting Supabase and Blob from Vercel's Storage tab fills in their variables for you.

# --- Database: Supabase (Vercel > Storage > Supabase, or Supabase > Project settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Image uploads: Vercel Blob (Vercel > Storage > Blob, added automatically when connected) ---
BLOB_READ_WRITE_TOKEN=

# --- Portal logins (required on the live site; change for every client) ---
ADMIN_EMAIL=you@yourstudio.com
ADMIN_PASSWORD=
CLIENT_EMAIL=client@theirshop.com
CLIENT_PASSWORD=
# At least 16 random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# --- Optional email alerts for new enquiries and orders (resend.com) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
