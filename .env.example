# Copy to .env.local for local development. On Hostinger: Website > Environment variables. On Vercel: Project > Settings > Environment Variables.

# --- Database and photo storage: Supabase (Supabase > Project settings > API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct database connection, used once to create the tables (Supabase > Project settings > Database > Connection string, port 5432)
POSTGRES_URL_NON_POOLING=

# --- Portal logins (required on the live site; change for every client) ---
ADMIN_EMAIL=you@yourstudio.com
ADMIN_PASSWORD=
CLIENT_EMAIL=client@theirshop.com
CLIENT_PASSWORD=
# At least 16 random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# --- Optional email alerts for new enquiries and orders (resend.com) ---
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# --- Optional: Instagram reels (long-lived token from your Meta app; can also be pasted in Admin > Reels) ---
INSTAGRAM_ACCESS_TOKEN=
